# ==========================================
# BONOMO FESTAS - SUPABASE CONFIGURATION
# ==========================================

# URL do Projeto Supabase (ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Chave Anônima Pública (Project Settings -> API -> anon public)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Chave Service Role Secreta (Project Settings -> API -> service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==========================================
# CLOUDFLARE R2 - MEDIA STORAGE CONFIGURATION
# ==========================================

# URL Pública / Custom Domain do Bucket R2 (ex: https://media.bonomofestas.com.br ou https://pub-xxx.r2.dev)
VITE_CLOUDFLARE_R2_PUBLIC_URL=https://media.bonomofestas.com.br

# Nome do Bucket R2 (ex: bonomo-media)
VITE_CLOUDFLARE_R2_BUCKET_NAME=bonomo-media

# Cloudflare Account ID
VITE_CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id

# R2 API Token / Access Keys (se usando endpoint backend ou upload assinado)
VITE_CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
VITE_CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
