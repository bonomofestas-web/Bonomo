# ==========================================
# BONOMO FESTAS - SUPABASE CONFIGURATION
# ==========================================

# URL do Projeto Supabase (ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Chave Anônima Pública (Project Settings -> API -> anon public)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Chave Service Role Secreta (Project Settings -> API -> service_role)
# Necessária para scripts de automação de migrations e setup inicial
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
