# -------------------------------------------------------------------------
# 1. FRONT-END (Públicas - Vão para o navegador com segurança via RLS/CDN)
# -------------------------------------------------------------------------

# URL pública da API do Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co

# Chave Anônima Pública do Supabase (protegida por Row Level Security no PostgreSQL)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# URL pública / Domínio CDN do Cloudflare R2 para visualização de imagens/vídeos
VITE_CLOUDFLARE_R2_PUBLIC_URL=https://pub-dfdef15994014f9c933c40b4ccde124b.r2.dev


# -------------------------------------------------------------------------
# 2. BACKEND / SERVERLESS (SECRETAS - NUNCA VÃO PARA O NAVEGADOR)
# Cadastre na Vercel (Environment Variables) e no .env local sem prefixo VITE_
# -------------------------------------------------------------------------

# Chave de Administração do Supabase (Apenas scripts de setup/backend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

